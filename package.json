{
  "name": "chatai-deep-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "backend:dev": "pnpm --filter chatgpt_backend run start:dev",
    "backend:build": "pnpm --filter chatgpt_backend run build",
    "backend:lint": "pnpm --filter chatgpt_backend run lint",
    "backend:test": "pnpm --filter chatgpt_backend run test",
    "backend:cloudflare:dev": "wrangler dev --config cloudflare/backend/wrangler.jsonc",
    "backend:cloudflare:deploy": "wrangler deploy --config cloudflare/backend/wrangler.jsonc",
    "backend:cloudflare:check": "tsc --noEmit -p cloudflare/backend/tsconfig.json",
    "backend:cloudflare:test": "node --test cloudflare/backend/src/container-env.test.ts",
    "backend:cloudflare:supervisor-test": "sh cloudflare/backend/test/start-container-supervisor.test.sh",
    "backend:cloudflare:types": "wrangler types --config cloudflare/backend/wrangler.jsonc cloudflare/backend/worker-configuration.d.ts",
    "admin:dev": "pnpm --filter chatgpt_admin run dev",
    "admin:build": "pnpm --filter chatgpt_admin run build",
    "admin:lint": "pnpm --filter chatgpt_admin run lint",
    "admin:typecheck": "pnpm --filter chatgpt_admin run typecheck",
    "node:lint": "pnpm -r --filter ./chatgpt_backend --filter ./chatgpt_admin run lint",
    "node:build": "pnpm -r --filter ./chatgpt_backend --filter ./chatgpt_admin run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "wrangler": "^4.50.0"
  }
}
