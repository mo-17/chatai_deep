FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY chatgpt_backend/package.json chatgpt_backend/package.json
COPY chatgpt_admin/package.json chatgpt_admin/package.json
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile

COPY chatgpt_backend chatgpt_backend
RUN pnpm --filter chatgpt_backend run build

FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS prod-deps

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY chatgpt_backend/package.json chatgpt_backend/package.json
COPY chatgpt_admin/package.json chatgpt_admin/package.json
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm --filter chatgpt_backend install --prod --frozen-lockfile --ignore-scripts

FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS runtime

ARG TIGRISFS_VERSION=1.2.1
ARG TIGRISFS_SHA256_AMD64=9fd6e7a9f3e7d86571ea55c66459205e94dfa5f6a25887d7e95c0a46f7641ed4
ARG TIGRISFS_SHA256_ARM64=f446e4cdf23b896ccad2efe9de0499e20f93dc44f4e7d8b38b07b257877aa185

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl fuse3 \
    && arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
         amd64) tigrisfs_sha256="$TIGRISFS_SHA256_AMD64" ;; \
         arm64) tigrisfs_sha256="$TIGRISFS_SHA256_ARM64" ;; \
         *) echo "Unsupported TigrisFS architecture: $arch" >&2; exit 1 ;; \
       esac \
    && curl -fsSL --retry 3 \
      "https://github.com/tigrisdata/tigrisfs/releases/download/v${TIGRISFS_VERSION}/tigrisfs_${TIGRISFS_VERSION}_linux_${arch}.tar.gz" \
      -o /tmp/tigrisfs.tar.gz \
    && echo "${tigrisfs_sha256}  /tmp/tigrisfs.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/tigrisfs.tar.gz -C /usr/local/bin \
    && chmod +x /usr/local/bin/tigrisfs \
    && rm -rf /var/lib/apt/lists/* /tmp/tigrisfs.tar.gz

WORKDIR /workspace/chatgpt_backend
COPY --from=prod-deps /workspace/node_modules /workspace/node_modules
COPY --from=prod-deps /workspace/chatgpt_backend/node_modules ./node_modules
COPY --from=prod-deps /workspace/chatgpt_backend/package.json ./package.json
COPY --from=build /workspace/chatgpt_backend/dist ./dist
COPY cloudflare/backend/start-container.sh /usr/local/bin/start-container

ENV NODE_ENV=production
ENV DB_SYNCHRONIZE=false
ENV PORT=3000
EXPOSE 3000

CMD ["start-container"]
