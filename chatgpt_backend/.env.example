# AI 服务商与模型在管理后台 → AI 配置 中维护
# 首次启动时，以下环境变量作为 seed 初值写入 DB（仅当 ai_providers 表为空时生效）
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 必填，缺失或 < 32 字节进程会直接退出。生成命令：openssl rand -base64 48
JWT_SECRET=CHANGE_ME
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
CORS_ORIGINS=http://localhost:3001
BCRYPT_ROUNDS=10

# 凭据加密主密钥（用于加密 smtp_providers.passwordEncrypted 等敏感字段，必须设置且勿入仓）
APP_SECRET_KEY=CHANGE_ME

# ---- 三家 SMTP 服务商「种子值」——首次启动若 smtp_providers 表为空时播种入库；之后以数据库为准 ----
# 通用 SMTP（QQ / 163 / Gmail / 自建）
SMTP_GENERIC_HOST=smtp.qq.com
SMTP_GENERIC_PORT=465
SMTP_GENERIC_SECURE=true
SMTP_GENERIC_USER=
SMTP_GENERIC_PASS=
SMTP_GENERIC_FROM_NAME=ChatAI Deep
SMTP_GENERIC_FROM_ADDRESS=
# 阿里云邮件推送
SMTP_ALIYUN_HOST=smtpdm.aliyun.com
SMTP_ALIYUN_PORT=465
SMTP_ALIYUN_SECURE=true
SMTP_ALIYUN_USER=
SMTP_ALIYUN_PASS=
SMTP_ALIYUN_FROM_NAME=ChatAI Deep
SMTP_ALIYUN_FROM_ADDRESS=
# 腾讯云 SES
SMTP_TENCENT_HOST=smtp.qcloudmail.com
SMTP_TENCENT_PORT=465
SMTP_TENCENT_SECURE=true
SMTP_TENCENT_USER=
SMTP_TENCENT_PASS=
SMTP_TENCENT_FROM_NAME=ChatAI Deep
SMTP_TENCENT_FROM_ADDRESS=

# ---- 验证码策略（auth_settings 表的种子值） ----
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_RESEND_INTERVAL_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_DAILY_LIMIT_PER_IDENTIFIER=10

# ---- 华为账号（同时支持 getAuthCode 与 quickLogin，后台可切换） ----
HUAWEI_APP_ID=
HUAWEI_APP_SECRET=
HUAWEI_TOKEN_VERIFY_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/tokeninfo
HUAWEI_QUICKLOGIN_VERIFY_URL=https://oauth-login.cloud.huawei.com/rest.php

# ---- Sign in with Apple ----
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.imooc.chatgpt_flutter
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/apple-auth-key.p8
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# ---- MCP Host（后端代理 MCP，方案 B）----
# server 列表现存于 DB，由管理后台「MCP 服务」维护。以下 JSON 仅作「种子值」：
# 首次启动若 mcp_servers 表为空时播种入库；之后以 DB 为准（改这里不再生效）。
# 支持 http（Streamable HTTP 远程）与 stdio（本地子进程）。
# 示例：
# MCP_SERVERS=[{"id":"everything","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-everything"]},{"id":"docs","transport":"http","url":"https://example.com/mcp","headers":{"Authorization":"Bearer xxx"}}]
MCP_SERVERS=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=huangzhibin
DB_PASSWORD=
DB_NAME=chatgpt_flutter
DB_LOGGING=false
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# 生产环境默认 false。当前项目暂无正式 migration；仅空库首次建表时临时设为 true，成功后立即改回 false。
DB_SYNCHRONIZE=false
NODE_ENV=development

# 上传文件目录。Cloudflare Container 部署时由启动脚本设为 R2 FUSE 挂载目录。
UPLOADS_DIR=./uploads
