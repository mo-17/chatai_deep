{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json"
  },
  "projects": {
    "chatgpt_backend": {
      "type": "application",
      "root": ".",
      "entryFile": "src/main",
      "sourceRoot": "src"
    },
    "auth-kit": {
      "type": "library",
      "root": "libs/auth-kit",
      "entryFile": "index",
      "sourceRoot": "libs/auth-kit/src"
    }
  }
}
