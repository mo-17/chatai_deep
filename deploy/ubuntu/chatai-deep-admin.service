[Unit]
Description=ChatAI Deep Admin
Wants=network-online.target chatai-deep-api.service
After=network-online.target chatai-deep-api.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=chatai
Group=chatai
WorkingDirectory=/opt/chatai-deep/current/chatgpt_admin
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NEXT_PUBLIC_BACKEND=http://127.0.0.1:3000
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=HOME=/var/lib/chatai-deep
ExecStart=/opt/chatai-deep/node/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3001
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/chatai-deep
MemoryAccounting=true
MemoryHigh=384M
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
