# 实际文件由 setup.sh 在 /etc/chatai-deep/backend.env 首次生成（权限 0600）。
# 使用简单 KEY=value；不要执行 source，也不要将真实密钥写回源码。
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=chatai_app
DB_NAME=chatai_app
DB_PASSWORD=GENERATED_ON_SERVER
DB_POOL_MAX=3
DB_SSL=false
DB_SYNCHRONIZE=false
JWT_SECRET=GENERATED_ON_SERVER
APP_SECRET_KEY=GENERATED_ON_SERVER
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=GENERATED_ON_SERVER
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
UPLOADS_DIR=/var/lib/chatai-deep/uploads
SYNC_V2_SHADOW_ENABLED=false
SYNC_V2_SHADOW_USER_IDS=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
